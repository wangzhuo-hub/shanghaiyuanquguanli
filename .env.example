# 复制为 .env.local 后按需填写（勿提交含密钥的文件）
# cp .env.example .env.local

# ---------- 千问 / DashScope（ai-proxy.mjs，Docker 服务 ai-proxy）----------
QWEN_API_KEY=
# 或使用：DASHSCOPE_API_KEY=

# ---------- 本地开发：Vite 端口与代理目标（固定 1001 / 1002；占用时报错不自动换端口）----------
VITE_DEV_PORT=1001
VITE_PB_DEV_PORT=1002
# VITE_AI_PROXY_PORT=3010

# ---------- 前端 PocketBase ----------
# 不设置时浏览器默认使用同源 /api/pb（需配合 Vite 或 Nginx 反代）
# VITE_POCKETBASE_URL=http://127.0.0.1:1002
# VITE_POCKETBASE_PROJECT_ID=park_data_main
# VITE_POCKETBASE_EMAIL=admin@example.com
# VITE_POCKETBASE_PASSWORD=

# ---------- 前端重计算兜底 ----------
# 默认：开发/测试允许本地重计算兜底，生产构建禁用，避免后台异常时浏览器自动跑大计算。
# 生产若必须支持离线/无网关本地重算，可显式设置为 true；要强制关闭可设置为 false。
# VITE_ENABLE_LOCAL_HEAVY_COMPUTE_FALLBACK=auto

# ---------- 可选：显式指定 AI 代理根地址（默认同源 /api/chat）----------
# VITE_QWEN_PROXY_URL=http://127.0.0.1:3010

# ---------- 集成网关：OpenClaw / API 写入与服务端 KPI 重算 ----------
# INTEGRATION_INTERNAL_TOKEN 只给服务端 gateway/MCP 使用，不要作为 VITE_* 暴露到前端 bundle。
# INTEGRATION_INTERNAL_TOKEN=
# INTEGRATION_GATEWAY_PORT=8787
# APP_API_WRITE_ENABLED=0
# APP_API_PAYMENT_WRITE_ENABLED=0
# APP_API_TENANT_WRITE_ENABLED=0
# 服务端计算缓存：缓存键包含 dashboard_data_version，写入成功后会清缓存；TTL 主要控制热缓存保温时间。
# COMPUTE_DASHBOARD_CACHE_TTL_MS=1800000
# COMPUTE_BILLING_CACHE_TTL_MS=1800000
# COMPUTE_VERSION_CACHE_TTL_MS=2000
# 独立计算预热：只预热 compute 缓存，不开启封账/审计清理；本地默认关闭，生产可开启。
# COMPUTE_PREWARM_ENABLED=0
# COMPUTE_PREWARM_INTERVAL_MS=900000
# COMPUTE_PREWARM_STARTUP_DELAY_MS=15000
# COMPUTE_PREWARM_PROJECTS=shanghai_park,beijing_park,shenzhen_park
# 封账/审计调度是业务任务，不是缓存预热；确认封账策略后再开启。
# GATEWAY_SCHEDULER_ENABLED=0

# ---------- 收款核销 API（scripts/payment-api.ts，npm run payment-api）----------
# 默认需看板 users 账号登录；客户端无需 PB Admin，但服务端仍需 Admin 用于应收计算
# PB_URL=http://127.0.0.1:1002
# PB_ADMIN_EMAIL=
# PB_ADMIN_PASSWORD=
# PAYMENT_API_PORT=18788
# PAYMENT_API_DEFAULT_PROJECT=shanghai_park
# PAYMENT_API_ALLOW_ANONYMOUS=1   # 仅开发：跳过用户登录（不推荐生产）

# ---------- 园区招商 MCP（packages/park-mcp，npm run park-mcp）----------
# 用户登录（看板 users，可写入 Cursor mcp.json，勿提交）
# PARK_PB_URL=http://127.0.0.1:1002
# PARK_FACILITY_PB_URL=http://127.0.0.1:11002
# PARK_PROPERTY_PB_URL=http://127.0.0.1:11006
# PARK_EMAIL=
# PARK_PASSWORD=
# PARK_FACILITY_AUTO_LOGIN=1
# PARK_PROPERTY_AUTO_LOGIN=1
# KPI/应收实时计算（仅 MCP 服务端环境，勿发给终端用户）
# PB_ADMIN_EMAIL=
# PB_ADMIN_PASSWORD=
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3099
# MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1
# MCP_AUDIT_LOG=
# MCP_TOKEN_TTL_MS=28800000

# ---------- Gemini（若使用相关功能）----------
# GEMINI_API_KEY=
