# 复制为 .env.local 后按需填写（勿提交含密钥的文件）
# cp .env.example .env.local

# ---------- 千问 / DashScope（ai-proxy.mjs，Docker 服务 ai-proxy）----------
QWEN_API_KEY=
# 或使用：DASHSCOPE_API_KEY=

# ---------- 本地开发：Vite 端口与代理目标 ----------
# VITE_DEV_PORT=1001
# VITE_PB_DEV_PORT=8001
# VITE_AI_PROXY_PORT=3010

# ---------- 前端 PocketBase ----------
# 不设置时浏览器默认使用同源 /api/pb（需配合 Vite 或 Nginx 反代）
# VITE_POCKETBASE_URL=http://127.0.0.1:8001
# VITE_POCKETBASE_PROJECT_ID=park_data_main
# VITE_POCKETBASE_EMAIL=admin@example.com
# VITE_POCKETBASE_PASSWORD=

# ---------- 可选：显式指定 AI 代理根地址（默认同源 /api/chat）----------
# VITE_QWEN_PROXY_URL=http://127.0.0.1:3010

# ---------- Gemini（若使用相关功能）----------
# GEMINI_API_KEY=
